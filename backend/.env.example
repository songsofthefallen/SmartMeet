# Comma-separated browser origins allowed to call the local API.
FRONTEND_ORIGINS=http://localhost:3000
# Deterministic schedule buffers in whole minutes; both default to zero.
TRAVEL_BUFFER_MINUTES=0
PREPARATION_BUFFER_MINUTES=0
# OpenRouter is the sole AI gateway; credentials stay in backend/.env.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace_with_openrouter_api_key
# OpenRouter's free-model router is the default; override to pin a model.
AI_MODEL=openrouter/free
# MySQL connection URL. Keep this in backend/.env, never in frontend variables.
# URL-encode reserved characters in the username and password.
DATABASE_URL=mysql+pymysql://db_user:replace_me@127.0.0.1:3306/deadline_notifier
# Clerk Dashboard > API Keys > JWT public key (PEM); public verification key, not a signing secret.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace_with_clerk_jwt_public_key\n-----END PUBLIC KEY-----"
# Exact issuer value from the Clerk session token's `iss` claim.
CLERK_ISSUER=https://replace-with-your-clerk-instance.clerk.accounts.dev
# TomTom Developer Portal > API Keys. Keep this server-side in backend/.env.
TOMTOM_API_KEY=replace_with_tomtom_api_key
# Web Push VAPID application server credentials. Keep the private key secret.
VAPID_PUBLIC_KEY=replace_with_base64url_public_key
# May be PEM content with escaped \n newlines or unpadded URL-safe base64 DER.
VAPID_PRIVATE_KEY=replace_with_private_key
VAPID_SUBJECT=mailto:admin@example.com
# Fernet key used to encrypt stored browser endpoints and auth/p256dh keys.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=replace_with_generated_fernet_key
