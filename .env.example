# Browser-visible API base URL for the local FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Public VAPID application server key from backend/.env; never put private keys here.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_base64url_public_key
# Clerk development publishable key (safe for browser use).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Clerk secret key; server-side only. Never use a production key in local tests.
CLERK_SECRET_KEY=sk_test_replace_me
